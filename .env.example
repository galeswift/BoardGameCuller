# Postgres connection string. On Railway set this to ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/collection_cull
# Password for the shared sign-in page. Use something long.
APP_PASSWORD=change-me
# BoardGameGeek XML API token (register an app at https://boardgamegeek.com/applications).
BGG_API_TOKEN=
# Optional: profile opened by default; it starts from the bundled lib/collection.json.
DEFAULT_PROFILE=galeswift
# Optional: eBay developer keys (https://developer.ebay.com). When set, eBay active
# listings fill in values where BGG GeekMarket has too few listings.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional: OpenAI API key for AI-written eBay descriptions (template used without it).
OPENAI_API_KEY=
# Optional: OpenAI model for descriptions (default gpt-5-mini).
OPENAI_MODEL=
